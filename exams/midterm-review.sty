\definecolor{courseblue}{HTML}{183B5B}
\definecolor{solutionblue}{HTML}{285F83}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}
\setlist[enumerate,1]{label=\textbf{\arabic*.},leftmargin=1.8em,itemsep=0.7em,topsep=0.5em}
\setlist[enumerate,2]{label=(\alph*),leftmargin=2em,itemsep=0.45em,topsep=0.3em}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small MATH 411 · Midterm 1 review}
\fancyhead[R]{\small\thepage}
\renewcommand{\headrulewidth}{0.3pt}
\newif\ifsolutions
\solutionsfalse
\newcommand{\C}{\mathbb C}
\newcommand{\R}{\mathbb R}
\newcommand{\Hupper}{\mathbb H}
\newcommand{\ExamHeader}[3]{%
  {\color{courseblue}\LARGE\bfseries Midterm Exam 1 · #1}\par
  {\large MATH 411 · #2}\par
  \ifsolutions {\color{solutionblue}\bfseries Complete worked solutions}\par\fi
  \vspace{0.2em}\hrule\vspace{0.5em}
  {\small #3}\par\vspace{0.25em}
}
\long\def\worked#1{%
  \ifsolutions
    \par\smallskip
    {\color{solutionblue}\textbf{Solution.}}\enspace #1
    \par\smallskip
  \fi
}
